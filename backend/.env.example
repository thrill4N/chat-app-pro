# Copy this file to .env and fill in real values.
# Never commit the actual .env file -- only this .env.example template.

# --- Server ---
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
HEALTHCHECK_URL=http://localhost:5001/health

# --- Database (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat-app-pro

# --- Auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=replace_with_clerk_webhook_secret

# --- Media uploads (ImageKit) ---
IMAGEKIT_PRIVATE_KEY=replace_with_imagekit_private_key

# --- Malware scanning (VirusTotal) ---
# Free account at virustotal.com -> API key under your profile.
# If left unset, file uploads still work but skip the malware-scan step.
VIRUSTOTAL_API_KEY=

# --- AI Chatbot + Moderation (Gemini) ---
# From aistudio.google.com -> Get API key.
AI_AGENT_API_KEY=
AI_AGENT_MODEL=gemini-2.5-flash
# Optional: override just the moderation classifier's model independently
# of the chatbot's. Falls back to AI_AGENT_MODEL if unset.
MODERATION_MODEL=

# --- Caching (Redis) ---
# Local dev without Docker: run `redis-server` or `docker run -p 6379:6379 redis:7-alpine`.
# Via docker-compose (see root docker-compose.yml): auto-overridden to
# redis://redis:6379 -- no need to change it here for that path.
# If left unset entirely, the app runs correctly without caching (just
# hits MongoDB directly on every request).
REDIS_URL=redis://localhost:6379
